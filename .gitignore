# ==========================================================
# UN_Votes_Clustering - .gitignore
# ==========================================================

# --- Envs & credenciales ---
.env
*.env
.venv/
venv/
env/
ENV/

# --- Caché de Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Notebooks ---
.ipynb_checkpoints/

# --- Logs ---
logs/
*.log

# --- IDE / Sistema ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Datos y artefactos de ML ---
# Ignorar todos los datos crudos y archivos pesados
data/**
datasets/**
*.sav
*.dta
*.parquet
*.xlsx
*.csv

# Re-incluir estructura mínima y procesados permitidos ✅
!data/
!data/raw/
!data/processed/
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/*.csv  # dataset limpio y etiquetado ✅
!data/processed/*.parquet

# Ignorar explícitamente dataset original Kaggle
data/raw/un_votes_raw.csv

# --- Figuras ---
figures/
!figures/
!figures/*.png
!figures/*.jpg
!figures/*.jpeg
!figures/*.html
!figures/.gitkeep

# --- GeoData pesada (si se usan shapefiles) ---
*.shp
*.shx
*.dbf
*.prj
*.cpg